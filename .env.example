# Salin menjadi .env lalu isi. File .env tidak ikut ter-commit.

# ---------- Publik: aman dipakai di browser ----------
# Dashboard Supabase > Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# Alamat frontend, sama dengan Site URL di Supabase Auth
SITE_URL=https://<nama-project>.vercel.app

# ---------- Rahasia: hanya di komputermu atau server, jangan pernah di frontend ----------
SUPABASE_PROJECT_REF=
# Mengabaikan semua RLS
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard Supabase > Connect, dipakai untuk impor nim_registry
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ---------- SMTP email konfirmasi: diisi di Supabase Auth, bukan dibaca aplikasi ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
